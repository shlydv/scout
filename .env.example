# Copy to .env.local and fill in. Only the first block is needed to run the site.

# ── Required ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres URL for search and scripts. Use the transaction pooler (port 6543) on Vercel.
SUPABASE_DB_URL=
# Search: DeepSeek plans and verifies queries; Voyage embeds them (must match the index).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIM=1024

# ── Admin, cron, alerts (production) ───────────────────────────────────────
# Bearer secret for /api/cron/search-alerts, /api/revalidate and /api/admin/*.
CRON_SECRET=
ADMIN_SECRET=
# Comma-separated Google emails allowed into /admin.
ADMIN_EMAILS=
# Saved-search alert emails. The "Alert me" button stays hidden unless both are set.
RESEND_API_KEY=
RESEND_FROM=Scout <onboarding@resend.dev>
NEXT_PUBLIC_SEARCH_ALERTS=

# ── Optional ───────────────────────────────────────────────────────────────
# Sentry error monitoring; leave empty to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Read-only Postgres URL for ad-hoc analysis scripts.
SCOUT_RO_DB_URL=
# Separate DeepSeek key for offline label extraction (falls back to DEEPSEEK_API_KEY).
DEEPSEEK_LABEL_API_KEY=
# Scoring: v9 is the default; bump the rule version when the formula changes,
# then re-run `pnpm score -- --force`.
# SCORING_ENGINE=v9
# SCORING_RULE_VERSION=10
# Label OCR runs locally on macOS with Apple Vision (see ocr-pipeline/README.md).
OCR_BACKEND=vision
# OCR_PIPELINE_PYTHON=/path/to/scout/ocr-pipeline/.venv/bin/python
